# ── API Keys ──────────────────────────────────────────────────────────────────
#
# 至少填一個，建議兩個都填（Google AI Studio 優先，額度耗盡時自動切換 OpenRouter）

# Google AI Studio API Key（免費，優先使用）
# 申請：https://aistudio.google.com → Get API Key
GOOGLE_AI_STUDIO_API_KEY=

# OpenRouter API Key（備援，按 token 計費）
# 申請：https://openrouter.ai → 儲值後取得
OPENROUTER_API_KEY=

# API Ninjas（選填，用於美股財報與法說逐字稿）
# 申請：https://api-ninjas.com
NINJA_API_KEY=

# Brave Search API Key（選填，提升網頁搜尋品質）
# 申請：https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
